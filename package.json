{
  "name": "intervue",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.1",
  "scripts": {
    "dev": "pnpm --parallel --filter @intervue/web --filter @intervue/api dev",
    "dev:web": "pnpm --filter @intervue/web dev",
    "dev:api": "pnpm --filter @intervue/api dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --check .",
    "db:generate": "pnpm --filter @intervue/api db:generate",
    "db:migrate": "pnpm --filter @intervue/api db:migrate",
    "db:studio": "pnpm --filter @intervue/api db:studio"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "eslint": "9.39.4",
    "prettier": "3.8.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}
