COMPOSE_PROJECT_NAME=intervue-dev
BACKEND_IMAGE=ghcr.io/sebastianaben/intervue-api:dev
NONVERBAL_INFERENCE_IMAGE=ghcr.io/sebastianaben/intervue-nonverbal-inference:dev

POSTGRES_DB=intervue
POSTGRES_USER=intervue
POSTGRES_PASSWORD=change-this-postgres-password

JWT_SECRET=change-this-long-random-secret
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Set this to the Vercel frontend origin that should call the API.
# Leave SESSION_COOKIE_DOMAIN empty when frontend uses a *.vercel.app domain and calls the API through /api/backend.
CORS_ORIGIN=https://intervue-git-dev.vercel.app
SESSION_COOKIE_DOMAIN=

# Use 4201 for dev and 4200 for main unless you intentionally change NPM routes.
BACKEND_HOST_BIND=0.0.0.0
BACKEND_HOST_PORT=4201
NONVERBAL_INFERENCE_LOGS=0
