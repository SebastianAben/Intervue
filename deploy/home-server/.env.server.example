COMPOSE_PROJECT_NAME=intervue-dev
BACKEND_IMAGE=ghcr.io/sebastianaben/intervue-api:dev

POSTGRES_DB=intervue
POSTGRES_USER=intervue
POSTGRES_PASSWORD=change-this-postgres-password

DATABASE_URL=postgresql://intervue:change-this-postgres-password@postgres:5432/intervue
JWT_SECRET=change-this-long-random-secret
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Set this to the Vercel production/preview frontend origin that should call the API.
CORS_ORIGIN=https://intervue-git-dev.vercel.app

# Use 4201 for dev and 4200 for main unless you intentionally change NPM routes.
BACKEND_HOST_BIND=0.0.0.0
BACKEND_HOST_PORT=4201

# Optional external/local ML inference service reachable from the backend container.
NONVERBAL_INFERENCE_URL=http://172.17.0.1:8765/predict
